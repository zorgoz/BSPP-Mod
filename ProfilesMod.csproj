<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>ProfilesMod</RootNamespace>
    <AssemblyName>ProfilesMod</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <BeatSaberDir Condition="'$(BeatSaberDir)' == ''">$(MSBuildThisFileDirectory)..\1.46.0</BeatSaberDir>
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">$(BeatSaberDir)\Beat Saber_Data\Managed</GameManagedDir>
    <GameLibsDir Condition="'$(GameLibsDir)' == ''">$(BeatSaberDir)\Libs</GameLibsDir>
    <BSIPALoaderPath Condition="'$(BSIPALoaderPath)' == ''">$(BeatSaberDir)\IPA\Data\Managed\IPA.Loader.dll</BSIPALoaderPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="IPA.Loader">
      <HintPath>$(BSIPALoaderPath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameLibsDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="System.Data.SQLite.Core" Version="1.0.119" />
    <EmbeddedResource Include="manifest.json" />
    <EmbeddedResource Include="Resources\PlayersButton.png" LogicalName="ProfilesMod.Resources.PlayersButton.png" />
    <EmbeddedResource Include="Resources\PlayersHighlightButton.png" LogicalName="ProfilesMod.Resources.PlayersHighlightButton.png" />
    <EmbeddedResource Include="Resources\PlayersButtonOverlay.png" LogicalName="ProfilesMod.Resources.PlayersButtonOverlay.png" />
  </ItemGroup>
</Project>
